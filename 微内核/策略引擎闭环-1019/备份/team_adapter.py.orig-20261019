@dataclass
class LineageNode:
    """进化树谱系节点 —— 记录每条漏洞产出来自哪个编排模式、哪些中间步骤"""
    node_id: str                         # 唯一ID（哈希）
    pattern: str                         # M1 | M2 | M3 | M4 | M5
    parent_node_ids: List[str] = field(default_factory=list)
    vuln_type: str = ""
    payload: str = ""
    fitness: float = 0.0
    strategies_used: List[str] = field(default_factory=list)
    engine_count: int = 1                # 参与的 Agent 数量
    round_num: int = 0
    timestamp: str = ""
    note: str = ""


@dataclass
class AdapterConfig:
    """适配器运行时配置"""
    pattern: str = "auto"                # auto | M1 | M2 | M3 | M4 | M5 | M6
    n_parallel_engineers: int = 2        # M1 并行工程师数
    consensus_threshold: float = 0.6     # M2 共识阈值（两个审判官评分相近才通过）
    meta_compress_rounds: int = 3        # M5 压缩的历史轮数
    lineage_tracking: bool = True        # 是否追踪谱系
    evolution_bonus: bool = True         # 是否启用进化增强层
    task_slug: str = ""                  # M6 任务 slug（为空时自动检测 .task/ 目录）


