    testbroke_ok = False
    w("对照 T：锚点命中 %d 处（该是 1 处）—— 这一根对照是空的，换锚点" % ttxt.count(T_ANCHOR))
else:
    io.open(tp, "w", encoding="utf-8", newline="\n").write(ttxt.replace(T_ANCHOR, T_BAD))
